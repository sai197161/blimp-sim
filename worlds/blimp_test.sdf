<?xml version="1.0"?>
<sdf version="1.8">
  <world name="blimp_test">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <!-- Lighter-than-air: buoyancy from displaced AIR -->
    <plugin filename="ignition-gazebo-buoyancy-system" name="ignition::gazebo::systems::Buoyancy">
      <uniform_fluid_density>1.225</uniform_fluid_density>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.75 1</background><shadows>true</shadows></scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Floor with a checker texture-ish pattern so the downward camera has features -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.45 0.45 0.4 1</ambient><diffuse>0.45 0.45 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Simple "room" features for lidar/camera: a few boxes and pillars -->
    <model name="wall_n"><static>true</static><pose>8 0 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 12 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 12 3</size></box></geometry><material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>2 6 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>12 0.2 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>12 0.2 3</size></box></geometry><material><ambient>0.7 0.6 0.6 1</ambient><diffuse>0.7 0.6 0.6 1</diffuse></material></visual></link></model>
    <model name="pillar_1"><static>true</static><pose>4 -2 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>3</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>3</length></cylinder></geometry><material><ambient>0.2 0.5 0.3 1</ambient><diffuse>0.2 0.5 0.3 1</diffuse></material></visual></link></model>
    <model name="box_1"><static>true</static><pose>3 2 0.4 0 0 0.5</pose><link name="l">
      <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><ambient>0.8 0.6 0.2 1</ambient><diffuse>0.8 0.6 0.2 1</diffuse></material></visual></link></model>
    <model name="mat_1"><static>true</static><pose>1.5 0 0.005 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="mat_2"><static>true</static><pose>2.5 -1 0.005 0 0 0.7</pose><link name="l">
      <visual name="v"><geometry><box><size>1 1 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>

    <include>
      <uri>model://blimp</uri>
      <name>blimp</name>
      <pose>0 0 1.5 0 0 0</pose>
    </include>
  </world>
</sdf>
